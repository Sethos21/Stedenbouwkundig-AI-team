    "guard_source": "\"\"\"Milestone 2D-6 validation-only audit guard; inherited by Python CLI subprocesses.\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport sys\n\nlog = Path(__file__).resolve().parent / ('process-' + str(os.getpid()) + '.jsonl')\n\ndef record(kind, event=None):\n    with log.open('a', encoding='utf-8') as stream:\n        stream.write(json.dumps({'kind': kind, 'event': event, 'pid': os.getpid()}) + '\\n')\n\ndef deny_network(event, args):\n    if event.startswith('socket.'):\n        record('BLOCKED', event)\n        raise RuntimeError('MILESTONE_2D_NETWORKLESS: ' + event)\n\nsys.addaudithook(deny_network)\nrecord('INSTALLED')\n\n",
